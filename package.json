{
  "name": "webmanager",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "pnpm --filter @webmanager/web dev",
    "build": "pnpm --filter @webmanager/web build && pnpm --filter @webmanager/api build",
    "typecheck": "pnpm --filter @webmanager/web typecheck && pnpm --filter @webmanager/api typecheck",
    "docker:dev": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs --follow web-user",
    "api:dev": "pnpm --filter @webmanager/api dev",
    "db:migrate": "pnpm --filter @webmanager/api db:migrate",
    "test": "pnpm --filter @webmanager/api test",
    "docker:portals": "docker compose --profile multi-portal up --build"
  }
}
