# Copy to .env for Docker Compose or .env.local for local development.
# Never commit real secrets. Generate AUTH_SECRET with a cryptographically secure random value.

DATABASE_URL=postgres://webmanager:webmanager_local_only@db:5432/webmanager
AUTH_SECRET=
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
DB_POOL_MAX=10
DATABASE_SSL=false
TRUST_PROXY=false

# Local SMTP capture via Mailpit (Docker Compose)
EMAIL_FROM=WebManager <no-reply@webmanager.local>
EMAIL_SERVER_HOST=mailpit
EMAIL_SERVER_PORT=1025
EMAIL_SERVER_SECURE=false
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# Browser-facing URL and allowed origins for local development
NEXT_PUBLIC_API_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Portal instance identity
NEXT_PUBLIC_PORTAL_KIND=user
PORTAL_KIND=user
